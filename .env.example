# Open-Meteo Explorer
# All weather data APIs are keyless — the app runs with no configuration at all.

# Optional: Google Apps Script web-app URL that logs data downloads to a Google
# Sheet and emails the site owner. See scripts/apps-script/README.md for setup.
# If this is unset, the download contact form is skipped and exports work as
# normal — a missing endpoint must never block anyone from getting data.
VITE_DOWNLOAD_LOG_ENDPOINT=

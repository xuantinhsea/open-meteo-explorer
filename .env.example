# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and will never be committed.

# ── Clerk (authentication) ────────────────────────────────────────────────────
# Get from: Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ── Clerk Webhook (registration alerts) ───────────────────────────────────────
# Get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_signing_secret_here

# ── Resend (email notifications) ──────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Your email address — registration and download alerts are sent here
NOTIFY_EMAIL=xuantinhsea@gmail.com

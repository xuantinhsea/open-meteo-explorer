# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and will never be committed.

# ── Clerk (authentication) ────────────────────────────────────────────────────
# Get from: Clerk Dashboard → API Keys → Publishable keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Clerk Backend API Key for admin panel user list
# Get from: Clerk Dashboard → API Keys → Secret keys (starts with sk_test_)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ── Clerk Webhook (registration alerts) ───────────────────────────────────────
# Get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_signing_secret_here

# ── Admin Access ──────────────────────────────────────────────────────────────
# Generate a random token (e.g., openssl rand -hex 16)
# Use same value for both ADMIN_SECRET and VITE_ADMIN_SECRET
ADMIN_SECRET=your_random_admin_secret_here
VITE_ADMIN_SECRET=your_random_admin_secret_here

# ── Resend (email notifications) ──────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Your email address — registration and download alerts are sent here
NOTIFY_EMAIL=xuantinhsea@gmail.com
